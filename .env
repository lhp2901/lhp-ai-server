# Cho Flask server
MODEL_PATH=model/model.pkl
PORT=10000
DEBUG=True
AI_BOT_USER_ID=2dd31bcf-b3b1-4aa1-861d-xxxx

# Danh sách cổ phiếu theo dõi
FOOTPRINT_SYMBOLS=DXG,HPG,FPT,SSI

# Giá trị mẫu; cần xác minh board ID với DNSE
FOOTPRINT_BOARD_ID=G1

# Bộ nhớ dữ liệu
FOOTPRINT_MAX_TRADES=20000
FOOTPRINT_CANDLE_SECONDS=60
FOOTPRINT_MAX_CANDLES=500
FOOTPRINT_MAX_PRICE_LEVELS=1000
FOOTPRINT_KEEP_TRADE_TAPE=true

# Phân loại bên mua/bán
# Để trống cho đến khi xác minh giá trị side trong dữ liệu DNSE
DNSE_SIDE_BUY_VALUE=
DNSE_SIDE_SELL_VALUE=
DNSE_SIDE_CASE_INSENSITIVE=true
FOOTPRINT_REQUIRE_CONFIRMED_SIDE=true

# Kết nối lại
DNSE_AUTO_RECONNECT=true
DNSE_RECONNECT_BASE_SECONDS=2
DNSE_RECONNECT_MAX_SECONDS=60
DNSE_CONNECT_TIMEOUT_SECONDS=15

# Khởi động và kiểm thử
DNSE_FOOTPRINT_AUTOSTART=false
FOOTPRINT_ENABLE_STREAM_CONTROL=true
FOOTPRINT_ENABLE_TEST_TICK=false
FOOTPRINT_LOG_LEVEL=INFO

# Lưu Supabase: chưa bật khi chưa triển khai bảng tương ứng
FOOTPRINT_SUPABASE_ENABLED=false
FOOTPRINT_SUPABASE_TRADES_TABLE=footprint_trades
FOOTPRINT_SUPABASE_CANDLES_TABLE=footprint_candles
